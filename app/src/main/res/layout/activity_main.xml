<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:visibility="gone" />

    <!-- 底部工具栏：单手拇指可达，是"舒服"的关键 -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="4dp">

        <ImageButton
            android:id="@+id/btn_home"
            style="@style/BarButton"
            android:contentDescription="@string/cd_home"
            android:src="@drawable/ic_home" />

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/BarButton"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back" />

        <ImageButton
            android:id="@+id/btn_forward"
            style="@style/BarButton"
            android:contentDescription="@string/cd_forward"
            android:src="@drawable/ic_arrow_forward" />

        <EditText
            android:id="@+id/address_bar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_address_bar"
            android:hint="@string/address_hint"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:paddingHorizontal="16dp"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_tabs"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_tab_count"
            android:contentDescription="@string/cd_tabs"
            android:gravity="center"
            android:text="1"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_menu"
            style="@style/BarButton"
            android:contentDescription="@string/cd_menu"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

</LinearLayout>
